/// Browser-safe GPU analysis surface.
///
/// This world excludes the WASI 0.3 async proof interface: the compatibility
/// GPU analyzer starts work synchronously and lets the JavaScript host await
/// browser WebGPU promises such as the optional one-way diagnostic `mapAsync`
/// summary readback.
world inspector-gpu-analysis {
  import host-log;
  import host-gpu;

  export gpu-analysis;
}

/// Chrome/JSPI-only GPU analysis surface.
///
/// This world is a sibling of `inspector-gpu-analysis`, not a replacement.
/// It exists to prove jco's async import/export path for diagnostic analyzer
/// work in browsers that expose JSPI. Safari and Firefox must keep using the
/// browser-safe worlds. Its direct async return decodes only the compact
/// diagnostic summary in Rust after upstream `gpu-buffer.map-async`;
/// reference-guided diagnostic visual output still uses GPU-resident resources.
world inspector-gpu-analysis-async {
  import host-log;
  import host-gpu;

  export gpu-analysis-async;
}

/// Scheduler-owned shared-frame GPU analysis surface.
///
/// This world is deliberately separate from both existing GPU worlds. The
/// browser scheduler creates the command encoder and submits it exactly once;
/// Rust may only append analyzer commands through a borrowed encoder handle.
/// Keeping this contract in its own world makes the ownership experiment
/// removable without changing the stable or JSPI component lifecycles.
world inspector-gpu-analysis-frame {
  import host-log;
  import host-gpu;

  export gpu-analysis-frame;
}
