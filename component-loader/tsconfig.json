{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["@webgpu/types"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "tsup.config.ts"],
  "exclude": ["dist"]
}
